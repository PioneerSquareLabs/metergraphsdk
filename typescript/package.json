{
  "name": "metergraph",
  "version": "0.6.3",
  "description": "Fire-and-forget LLM spend capture for Metergraph",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.json && node scripts/finish-build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run test:package",
    "test": "npm run build && npm run test:types && npm run test:examples && node --test test/*.test.mjs",
    "test:examples": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/ai-sdk-factories.types.ts",
    "test:package": "npm run build && node --test test/package/packed-package.test.mjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/ai-sdk-current.types.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "author": "Pioneer Square Labs",
  "homepage": "https://www.metergraph.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PioneerSquareLabs/metergraphsdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/PioneerSquareLabs/metergraphsdk/issues"
  },
  "keywords": ["llm", "observability", "openai", "anthropic", "gemini", "vercel-ai-sdk", "cost-tracking"],
  "dependencies": {},
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/openai": "^4.0.43",
    "@ai-sdk/openai-compatible": "^3.0.31",
    "@anthropic-ai/sdk": "^0.30",
    "@google/genai": "^1",
    "@types/node": "^24.0.0",
    "ai": "^7.0.55",
    "openai": "^7",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30",
    "@google/genai": ">=1",
    "ai": ">=5 <8",
    "openai": ">=4"
  },
  "peerDependenciesMeta": {
    "openai": {"optional": true},
    "@anthropic-ai/sdk": {"optional": true},
    "@google/genai": {"optional": true},
    "ai": {"optional": true}
  }
}
